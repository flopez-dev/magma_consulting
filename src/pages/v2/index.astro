---
import Base from '../../layouts/Base.astro';
import Header from '../../components/v2/Header.astro';
import Hero from '../../components/v2/Hero.astro';
import Credenciales from '../../components/v2/Credenciales.astro';
import Servicios from '../../components/v2/Servicios.astro';
import Nosotras from '../../components/Nosotras.astro';
import Valores from '../../components/Valores.astro';
import Contacto from '../../components/Contacto.astro';
import Footer from '../../components/v2/Footer.astro';
import Revelar from '../../components/Revelar.astro';
import { withBase } from '../../lib/withBase';
import { descripcion } from '../../lib/sitio';
import '../../styles/propuestas.css';

// Propuesta v2, para enseñar al cliente en paralelo a la home: las mejoras que salieron de
// auditar la home con la skill ui-ux-pro-max (patrón «Trust & Authority + Conversion»),
// filtradas por las reglas del sitio. Mismo copy y misma paleta; cambian el orden (la prueba
// antes que la solución), los CTA, el hero en móvil, el vídeo y la accesibilidad. No se indexa
// ni entra en el sitemap (ver astro.config.mjs).
const titulo = 'Magma Consulting | Consultoría para operadores (propuesta v2)';
---

<Base title={titulo} description={descripcion} noindex>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={withBase('/img/hero-bg-poster.jpg')}
      fetchpriority="high"
    />
  </Fragment>

  <div class="propuesta">
    <Header />

    <main id="main">
      <Hero />
      <Credenciales />
      <Servicios />
      <Valores />
      <Nosotras />
      <Contacto />
    </main>

    <Footer />
  </div>
  <Revelar />
</Base>
