---
import Base from '../../layouts/Base.astro';
import Revelar from '../../components/Revelar.astro';
import Cabecera from '../../components/v2/Cabecera.astro';
import Portada from '../../components/v2/Portada.astro';
import Piezas from '../../components/v2/Piezas.astro';
import Carta from '../../components/v2/Carta.astro';
import Terreno from '../../components/v2/Terreno.astro';
import Hitos from '../../components/v2/Hitos.astro';
import Socias from '../../components/v2/Socias.astro';
import Vitrina from '../../components/v2/Vitrina.astro';
import Visita from '../../components/v2/Visita.astro';
import Pie from '../../components/v2/Pie.astro';
import { descripcion } from '../../lib/sitio';
import '../../styles/v2.css';

// Propuesta de rediseño para enseñar al cliente, en paralelo a la home: la consultora vestida de
// gabinete de geología, por el nombre (Magma) y la paleta de estratos. No se indexa ni aparece en
// el sitemap (ver astro.config.mjs).
const titulo = 'Magma Consulting | Consultoría para operadores (propuesta v2)';
---

<Base title={titulo} description={descripcion} noindex>
  <div class="v2 relative">
    <Cabecera />
    <main id="main">
      <Portada />
      <Piezas />
      <Carta />
      <Terreno />
      <Hitos />
      <Socias />
      <Vitrina />
      <Visita />
    </main>
    <Pie />
  </div>
  <Revelar />
</Base>
