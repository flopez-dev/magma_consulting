---
import { secciones, contacto, legales } from '../lib/secciones';
import { correo, direccion, linkedinHref, mailtoHref, titular } from '../lib/contacto';
import { iconoCorreo, iconoLinkedin } from '../lib/iconos';
import { nombreSitio } from '../lib/sitio';
import { withBase } from '../lib/withBase';
import Icono from './Icono.astro';

const enHome = Astro.url.pathname === withBase('/');
const ancla = (id: string) => (enHome ? `#${id}` : withBase(`/#${id}`));
const enlaces = [...secciones, contacto];

const rotulo =
  'mt-0 mb-4 font-display text-[0.8rem] font-bold tracking-[0.12em] text-white uppercase';
// Los enlaces miden al menos 24 px de alto (WCAG 2.5.8).
const enlace =
  'inline-block py-1 text-[0.9rem] text-inherit no-underline transition-colors duration-200 ease-suave hover:text-teal-light focus-visible:text-teal-light';
---

<footer class="border-t border-teal bg-carbon pt-14 pb-10 text-white/70">
  <div class="mx-auto max-w-ancho px-4">
    {/* Marca con los datos de la empresa, navegación y contacto. El domicilio y la razón
        social a la vista dan confianza y refuerzan la señal local (Madrid) para buscadores. */}
    <div class="grid grid-cols-[1.4fr_1fr_1fr] gap-10 max-[720px]:grid-cols-1 max-[720px]:gap-8">
      <div>
        <a
          class="inline-flex items-center gap-2"
          href={enHome ? '#hero' : withBase('/')}
          aria-label={`${nombreSitio}, inicio`}
        >
          {/* El mismo logotipo que la cabecera, en blanco y alineado igual (ver Header.astro). */}
          <img
            class="relative -top-[3px] size-[22px] opacity-90 brightness-0 invert"
            src={withBase('/img/simbolo.svg')}
            alt=""
            width="22"
            height="22"
          />
          <img
            class="opacity-90 brightness-0 invert"
            src={withBase('/img/logo.svg')}
            alt={nombreSitio}
            width="110"
            height="22"
          />
        </a>
        <p class="mt-5 mb-0 text-[0.9rem]">{titular.nombreLegal}</p>
        <address class="text-[0.9rem] not-italic">
          {direccion.calle}
          <br />
          {`${direccion.codigoPostal} ${direccion.localidad}`}
        </address>
      </div>

      <nav aria-label="Enlaces del pie">
        <p class={rotulo}>Secciones</p>
        <ul class="m-0 grid list-none gap-1 p-0">
          {enlaces.map((e) => (
            <li>
              <a class={enlace} href={ancla(e.id)}>
                {e.texto}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class={rotulo}>Contacto</p>
        <ul class="m-0 grid list-none gap-1 p-0">
          <li class="flex items-center gap-2">
            <Icono d={iconoCorreo} class="size-[1.1em] flex-none text-teal-light" />
            <a class={enlace} href={mailtoHref}>
              {correo}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Icono d={iconoLinkedin} class="size-[1.1em] flex-none text-teal-light" />
            <a class={enlace} href={linkedinHref} target="_blank" rel="noopener">
              LinkedIn <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-10 gap-y-3 border-t border-white/10 pt-6">
      <p class="m-0 max-w-none text-[0.8rem]">
        &copy; <span data-year>{new Date().getFullYear()}</span> {nombreSitio}. Todos los derechos
        reservados.
      </p>

      <nav class="flex flex-wrap gap-x-5 gap-y-[0.4rem]" aria-label="Enlaces legales">
        {legales.map((l) => {
          const href = withBase(l.ruta);
          return (
            <a
              class="inline-block py-1 text-[0.8rem] text-inherit no-underline opacity-75 transition-[color,opacity] duration-200 ease-suave hover:text-teal-light hover:opacity-100 focus-visible:text-teal-light focus-visible:opacity-100"
              href={href}
              aria-current={Astro.url.pathname === href ? 'page' : undefined}
            >
              {l.texto}
            </a>
          );
        })}
      </nav>
    </div>
  </div>
</footer>

<script>
  // El año del pie se actualiza en el navegador: el sitio es estático y, sin esto, se
  // quedaría en el año del último despliegue.
  const anio = document.querySelector('[data-year]');
  if (anio) anio.textContent = String(new Date().getFullYear());
</script>
