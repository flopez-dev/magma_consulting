---
import { correo, direccion, linkedinHref, mailtoConsultaHref } from '../../lib/contacto';
import { nombreSitio } from '../../lib/sitio';
import Boton from '../Boton.astro';

// Créditos de las fotografías de la página, con su licencia. Van aquí, en lugar de solo en el
// pie, porque el pie es compartido con la home.
const creditos = [
  'Central telefónica de Hither Green, por Doyle of London (CC BY-SA 4.0), Wikimedia Commons.',
  'Tarjeta SIM, por Tomasz Sienicki (CC BY 2.5), Wikimedia Commons.',
  'Cable de fibra óptica, por Asurnipal (CC BY-SA 4.0), Wikimedia Commons.',
];
---

<section
  id="contacto"
  class="bg-carbon py-[clamp(3.5rem,3rem+2vw,6rem)] text-white"
  aria-labelledby="contacto-title"
>
  <div class="mx-auto grid max-w-ancho grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] items-start gap-12 px-4 max-[780px]:grid-cols-1">
    <div class="reveal">
      <h2 id="contacto-title" class="text-white">
        Hablemos de tu próximo proyecto
      </h2>
      <p class="text-[18px] text-white/85">
        Cuéntanos qué necesitas. Sumamos experiencia, visión y soluciones para hacer avanzar tu
        negocio.
      </p>
      <div class="mt-8">
        <Boton href={mailtoConsultaHref}>Escríbenos por correo</Boton>
      </div>
    </div>

    <div class="reveal bg-white p-8 text-carbon sm:p-10">
      <p class="m-0 mb-6 font-display text-[24px] font-extrabold text-carbon">{nombreSitio}</p>
      <ul class="m-0 grid list-none gap-4 p-0 text-[16px]">
        <li>
          <span class="block text-[13px] text-ink-soft">Correo</span>
          <a
            class="font-bold text-teal-deep underline-offset-4 hover:underline focus-visible:underline"
            href={mailtoConsultaHref}
          >
            {correo}
          </a>
        </li>
        <li>
          <span class="block text-[13px] text-ink-soft">Domicilio</span>
          {direccion.calle}, {direccion.codigoPostal} {direccion.localidad}
        </li>
        <li>
          <a
            class="font-bold text-teal-deep underline-offset-4 hover:underline focus-visible:underline"
            href={linkedinHref}
            target="_blank"
            rel="noopener"
          >
            LinkedIn <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-ancho px-4">
    <p class="m-0 text-[13px] text-white/60">
      {creditos.map((c) => (
        <span class="mr-6 inline-block">{c}</span>
      ))}
    </p>
  </div>
</section>
