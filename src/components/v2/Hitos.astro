---
// Los hitos de la trayectoria, como la tabla de un informe. Todo sale del texto del cliente: sin
// fechas, porque el cliente no las ha dado.
const filas = [
  {
    hito: 'Cablemóvil',
    que: 'Puesta en marcha del primer OMV completo de España',
    ambito: 'Telefonía móvil',
    alcance: 'Primer OMV FULL',
  },
  {
    hito: 'Ion Mobile',
    que: 'Lanzamiento de un OMV de referencia',
    ambito: 'Telefonía móvil',
    alcance: 'Referencia del mercado',
  },
  {
    hito: 'Avatel Móvil',
    que: 'Lanzamiento de un OMV de referencia',
    ambito: 'Telefonía móvil',
    alcance: 'Referencia del mercado',
  },
  {
    hito: 'Operadores locales',
    que: 'Desarrollo y comercialización de nuevos productos',
    ambito: 'Nacional',
    alcance: 'Más de 800 operadores',
  },
  {
    hito: 'Consolidación',
    que: 'Su última etapa profesional',
    ambito: 'Nacional',
    alcance: 'Más de 100 empresas',
  },
];
---

<section id="trayectoria" class="v2-marco v2-seccion bg-white" aria-labelledby="trayectoria-title">
  <h2 id="trayectoria-title" class="v2-titular-grande reveal">
    <span class="block">Del primer OMV</span>
    <span class="block pl-[calc((100%-11*var(--hueco))/12*2+2*var(--hueco))] max-[767px]:pl-0">
      a más de 100 empresas
    </span>
  </h2>

  <table class="v2-tabla reveal mt-[72px]" style="--i: 1">
    <thead class="v2-pequeno text-ink-soft">
      <tr>
        <th scope="col" class="w-[17%] font-normal">
          Hito
        </th>
        <th scope="col" class="w-[35%] font-normal">
          Qué fue
        </th>
        <th scope="col" class="w-[24%] font-normal">
          Ámbito
        </th>
        <th scope="col" class="text-right font-normal max-[767px]:text-left">
          Alcance
        </th>
      </tr>
    </thead>
    <tbody>
      {filas.map((f) => (
        <tr>
          <td class="font-display font-extrabold text-carbon">{f.hito}</td>
          <td>{f.que}</td>
          <td class="max-[767px]:text-ink-soft">{f.ambito}</td>
          <td class="text-right font-bold max-[767px]:text-left max-[767px]:text-ink-soft">
            {f.alcance}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</section>
