---
import { direccion, linkedinHref, mailtoConsultaHref } from '../../lib/contacto';
import { nombreSitio } from '../../lib/sitio';

// La dirección en filas de display, todas al mismo tamaño, en bandas de dos tonos de carbón.
const mapa = `https://www.openstreetmap.org/search?query=${encodeURIComponent(
  `${direccion.calle}, ${direccion.codigoPostal} ${direccion.localidad}`,
)}`;
const fila = 'v2-marco flex min-h-[150px] items-end pb-6 max-[767px]:min-h-[84px] max-[767px]:pb-4';
const texto = 'font-display font-medium leading-none tracking-[-0.02em]';
---

<section
  id="contacto"
  class="bg-carbon text-white"
  aria-labelledby="contacto-title"
  style="font-size: var(--t-display)"
>
  <div class:list={[fila, 'bg-carbon']}>
    <h2 id="contacto-title" class:list={[texto]} style="font-size: inherit">
      {nombreSitio}
    </h2>
  </div>
  <div class:list={[fila, 'bg-carbon-soft']}>
    <a
      class:list={[
        texto,
        'text-white no-underline hover:text-teal-light focus-visible:text-teal-light',
      ]}
      href={mapa}
      target="_blank"
      rel="noopener"
    >
      Avda. de Bruselas 61, 8º C <span class="sr-only">(mapa, se abre en una pestaña nueva)</span>
    </a>
  </div>
  <div class:list={[fila, 'bg-carbon']}>
    <p class:list={[texto, 'm-0']}>
      {direccion.codigoPostal} {direccion.localidad}
    </p>
  </div>
  <div class:list={[fila, 'bg-carbon-soft']}>
    <a
      class:list={[
        texto,
        'text-white no-underline hover:text-teal-light focus-visible:text-teal-light',
      ]}
      href={linkedinHref}
      target="_blank"
      rel="noopener"
    >
      LinkedIn <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </div>
  <div class:list={[fila, 'bg-carbon gap-6 max-[767px]:justify-between']}>
    <p class:list={[texto, 'm-0']}>Escríbenos</p>
    <a
      class="v2-boton size-[clamp(56px,5.6vw,84px)] min-h-0 shrink-0 p-0"
      href={mailtoConsultaHref}
      aria-label="Escríbenos por correo"
    >
      <svg
        viewBox="0 0 24 24"
        width="44"
        height="44"
        class="block size-11 shrink-0"
        aria-hidden="true"
      >
        <path d="M4 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" />
      </svg>
    </a>
  </div>
</section>
