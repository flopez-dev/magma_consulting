---
// Valores de la home, mismo texto. Aquí se componen como una lista impresa en lugar de una
// cuadrícula de tarjetas con icono.
const valores = [
  {
    nombre: 'Honestidad',
    texto: 'Si un proyecto no tiene sentido, te lo decimos antes de que inviertas en él.',
  },
  {
    nombre: 'Eficiencia',
    texto:
      'Conocemos el mercado desde dentro, así que vamos directas a lo que funciona y no te hacemos perder tiempo.',
  },
  {
    nombre: 'Pasión',
    texto:
      'Nos gusta este sector y se nota. Seguimos aprendiendo con cada operador al que acompañamos.',
  },
  {
    nombre: 'Compromiso',
    texto:
      'Nos implicamos en cada proyecto como si fuera nuestro y respondemos de lo que entregamos.',
  },
];

const extra = ['Diferenciación', 'Orientación al cliente', 'Responsabilidad social'];
---

<section
  id="valores"
  class="bg-mist py-[clamp(3.5rem,3rem+2vw,6rem)]"
  aria-labelledby="valores-title"
>
  <div class="mx-auto grid max-w-ancho grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] gap-12 px-4 max-[860px]:grid-cols-1">
    <div class="reveal">
      <h2 id="valores-title" class="text-carbon">
        Cómo trabajamos
      </h2>
      <ul class="m-0 mt-8 flex list-none flex-col items-start gap-3 p-0">
        {extra.map((v) => (
          <li class="bg-white px-4 py-2 font-display text-[16px] font-bold text-carbon">{v}</li>
        ))}
      </ul>
    </div>

    <dl class="m-0 grid gap-10">
      {valores.map((v) => (
        <div class="reveal">
          <dt class="m-0 mb-2 font-display text-[24px] font-extrabold text-carbon">{v.nombre}</dt>
          <dd class="m-0 max-w-[48ch] text-[16px] text-ink">{v.texto}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
