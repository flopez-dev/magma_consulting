---
import { socias } from '../../lib/equipo';
import { withBase } from '../../lib/withBase';

const foto = (nombre: string, ext: string) => withBase(`/img/equipo/${nombre}.${ext}`);
---

<section
  id="nosotras"
  class="bg-white py-[clamp(3.5rem,3rem+2vw,6rem)]"
  aria-labelledby="nosotras-title"
>
  <div class="mx-auto max-w-ancho px-4">
    <h2 id="nosotras-title" class="max-w-[24ch] text-carbon">
      Dos socias, una misma trayectoria
    </h2>
    <p class="seccion-entradilla">
      Te atendemos nosotras mismas, de principio a fin. Quien te asesora conoce el mercado del
      operador local desde dentro.
    </p>

    <div class="mt-14 grid gap-20">
      {socias.map((s, i) => (
        <article
          class:list={[
            'reveal grid items-center gap-12 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]',
            i % 2 === 1 && 'md:[&>picture]:order-2',
          ]}
        >
          <picture class="block aspect-[4/5] overflow-hidden bg-mist">
            <source srcset={foto(s.foto.nombre, 'webp')} type="image/webp" />
            <img
              class="size-full object-cover object-top"
              src={foto(s.foto.nombre, 'jpg')}
              alt={`Retrato de ${s.nombre}`}
              width={s.foto.ancho}
              height={s.foto.alto}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div>
            <h3 class="m-0 mb-2 font-display text-[24px] font-extrabold text-carbon">{s.nombre}</h3>
            <p class="mb-4 text-[16px] font-bold text-teal-deep">{s.trayectoria}</p>
            <p class="text-[16px]">{s.bio}</p>
            <p class="text-[16px] text-ink">{s.masBio}</p>
            <a
              class="font-display font-bold text-teal-deep underline-offset-4 hover:underline focus-visible:underline"
              href={s.linkedin}
              target="_blank"
              rel="noopener"
            >
              {s.nombre} en LinkedIn <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
