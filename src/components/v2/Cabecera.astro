---
import { withBase } from '../../lib/withBase';
import { nombreSitio } from '../../lib/sitio';

// Cabecera propia de la v2: sus anclas apuntan a las secciones de esta página, no a la home.
const enlaces = [
  { id: 'servicios', texto: 'Servicios' },
  { id: 'trayectoria', texto: 'Trayectoria' },
  { id: 'nosotras', texto: 'Nosotras' },
];
---

<header class="v2-marco absolute inset-x-0 top-0 z-10 flex items-center justify-between py-6">
  <a href="#inicio" class="inline-flex" aria-label={`${nombreSitio}, inicio`}>
    <img src={withBase('/img/logo.svg')} alt="" width="138" height="34" class="h-8 w-auto" />
  </a>
  <nav aria-label="Secciones de la propuesta">
    <ul class="m-0 flex list-none items-center gap-7 p-0 font-display font-bold">
      {enlaces.map((e) => (
        <li class="max-[700px]:hidden">
          <a
            class="text-carbon no-underline hover:text-teal-deep focus-visible:text-teal-deep"
            href={`#${e.id}`}
          >
            {e.texto}
          </a>
        </li>
      ))}
      <li>
        <a class="v2-enlace text-carbon" href="#contacto">
          Contacto
        </a>
      </li>
    </ul>
  </nav>
</header>
