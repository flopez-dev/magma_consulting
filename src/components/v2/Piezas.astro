---
import { fases } from '../../lib/servicios';

// «Muchas piezas en una»: 150 cuadrados que van del desorden (lanzar) a una franja comprimida en
// carbón, el magma (conectar), y a seis estratos ordenados en teal (operar). La composición final
// se pinta en el SVG; la escena los trae desde posiciones dispersas al hacer scroll. Las posiciones
// salen de un generador con semilla fija, así que el build es reproducible.
function generador(semilla: number) {
  let s = semilla;
  return () => {
    s = (s * 1664525 + 1013904223) % 4294967296;
    return s / 4294967296;
  };
}

interface Pieza {
  x: number;
  y: number;
  dx: number;
  dy: number;
  tono: string;
}

function piezas(ancho: number, alto: number, lado: number, vertical: boolean): Pieza[] {
  const azar = generador(vertical ? 7 : 3);
  const final: Omit<Pieza, 'dx' | 'dy'>[] = [];
  const estratos = [
    'fill-teal-light',
    'fill-teal-light',
    'fill-teal',
    'fill-teal',
    'fill-teal-deep',
    'fill-teal-deep',
  ];

  // Desorden: 36 piezas sueltas en dos tonos pálidos.
  for (let i = 0; i < 36; i++) {
    const x = vertical ? 40 + azar() * (ancho - 80) : 20 + azar() * (ancho / 3 - 80);
    const y = vertical ? 20 + azar() * (alto * 0.28) : 40 + azar() * (alto - 80);
    final.push({ x, y, tono: i % 2 ? 'fill-mist-deep' : 'fill-teal-light/50' });
  }
  // Franja comprimida: tres de grueso, 22 de largo, en carbón.
  for (let i = 0; i < 66; i++) {
    const fila = i % 3;
    const col = Math.floor(i / 3);
    const paso = lado + 4;
    const x = vertical
      ? ancho / 2 - paso * 1.5 + fila * paso
      : ancho / 3 + (ancho / 3 - 22 * paso) / 2 + col * paso;
    const y = vertical ? alto * 0.33 + col * paso : alto / 2 - paso * 1.5 + fila * paso;
    final.push({ x, y, tono: 'fill-carbon' });
  }
  // Estratos: seis filas de ocho, del teal claro al profundo.
  for (let i = 0; i < 48; i++) {
    const fila = Math.floor(i / 8);
    const col = i % 8;
    const x = vertical
      ? 60 + col * ((ancho - 120 - lado) / 7)
      : (ancho * 2) / 3 + 40 + col * ((ancho / 3 - 80 - lado) / 7);
    const y = vertical
      ? alto * 0.7 + fila * ((alto * 0.27 - lado) / 5)
      : 60 + fila * ((alto - 120 - lado) / 5);
    final.push({ x, y, tono: estratos[fila] });
  }

  return final.map((p) => ({
    ...p,
    dx: Math.round(azar() * (ancho - lado) - p.x),
    dy: Math.round(azar() * (alto - lado) - p.y),
  }));
}

const horizontales = piezas(1800, 400, 16, false);
const verticales = piezas(600, 900, 14, true);

const unir = (nombres: string[]) =>
  nombres
    .map((n, i) => (i === 0 ? n : n.charAt(0).toLowerCase() + n.slice(1)))
    .join(', ')
    .replace(/, ([^,]*)$/, ' y $1');
---

<section
  id="servicios"
  class="scene v2-marco bg-white"
  data-scene="piezas"
  aria-labelledby="servicios-title"
>
  <div class="scene-stage v2-seccion">
    <div class="v2-rejilla items-end gap-y-6">
      <h2 id="servicios-title" class="reveal col-span-6 max-w-[14ch] max-[767px]:col-span-12">
        Lo que sostiene a tu operador
      </h2>
      <p
        class="reveal col-span-5 col-start-8 m-0 max-[767px]:col-span-12 max-[767px]:col-start-1"
        style="--i: 1"
      >
        Más de 20 años impulsando las telecomunicaciones: lanzamos OMV, desplegamos redes FTTH y
        desarrollamos infraestructuras. Más de 800 operadores forman parte de nuestra trayectoria.
      </p>
    </div>

    <svg
      class="v2-piezas-horizontal mt-10 block h-auto w-full"
      viewBox="0 0 1800 400"
      role="img"
      aria-label="Piezas sueltas que se comprimen en una franja y salen ordenadas en seis estratos"
    >
      {horizontales.map((p) => (
        <rect
          x={p.x.toFixed(1)}
          y={p.y.toFixed(1)}
          width="16"
          height="16"
          class={p.tono}
          data-dx={p.dx}
          data-dy={p.dy}
        />
      ))}
    </svg>

    <div class="mt-8 grid grid-cols-3 gap-[var(--hueco)] max-[767px]:mt-6 max-[767px]:grid-cols-[minmax(0,1fr)_38vw]">
      <svg
        class="v2-piezas-vertical row-span-3 h-auto w-full"
        viewBox="0 0 600 900"
        role="img"
        aria-label="Piezas sueltas que se comprimen en una franja y salen ordenadas en seis estratos"
      >
        {verticales.map((p) => (
          <rect x={p.x.toFixed(1)} y={p.y.toFixed(1)} width="14" height="14" class={p.tono} />
        ))}
      </svg>
      {fases.map((fase, i) => (
        <div class="reveal max-[767px]:col-start-2 max-[767px]:self-center" style={`--i: ${i + 2}`}>
          <h3>{fase.nombre}</h3>
          <p class="mt-2 mb-0 max-w-[34ch]">{unir(fase.servicios.map((s) => s.nombre))}.</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { escena } from '../../lib/escena';

  const raiz = document.querySelector<HTMLElement>('[data-scene="piezas"]');
  if (raiz) {
    escena(raiz, {
      hold: 2,
      movil: 'reposo',
      construir(tl, q) {
        const piezas = q('.v2-piezas-horizontal rect') as SVGRectElement[];
        tl.fromTo(
          piezas,
          {
            x: (_i: number, el: SVGRectElement) => Number(el.dataset.dx),
            y: (_i: number, el: SVGRectElement) => Number(el.dataset.dy),
          },
          { x: 0, y: 0, duration: 0.85, stagger: { each: 0.001, from: 'random' } },
          0,
        );
        // Un tramo final de reposo: la composición terminada se sostiene antes de soltar.
        tl.to({}, { duration: 0.25 });
      },
    });
  }
</script>
