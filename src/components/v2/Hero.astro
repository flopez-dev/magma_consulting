---
import HeroContenido from './HeroContenido.astro';
import VideoFondo from './VideoFondo.astro';
---

<section
  id="hero"
  class="relative flex min-h-[92vh] items-center overflow-hidden bg-carbon pt-[calc(var(--spacing-cabecera)+2rem)] pb-16 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-teal max-[560px]:min-h-0 max-[560px]:pt-[calc(var(--spacing-cabecera)+1.5rem)] max-[560px]:pb-12"
  aria-labelledby="hero-title"
>
  <VideoFondo />
  <HeroContenido />

  <a
    class="absolute bottom-8 left-1/2 z-1 h-[42px] w-[26px] -translate-x-1/2 rounded-[20px] border-2 border-white/50 max-[560px]:hidden"
    href="#credenciales"
    aria-label="Ir a trayectoria"
  >
    <span
      class="indicador-scroll absolute top-2 left-1/2 -ml-[2px] h-2 w-1 rounded-[2px] bg-teal-light"
      aria-hidden="true"
    ></span>
  </a>
</section>

<script>
  import { videoHero } from './videoHero';

  videoHero();
</script>
