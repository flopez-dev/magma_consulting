---
import { secciones, legales } from '../../lib/secciones';
import { correo, titular } from '../../lib/contacto';
import { nombreSitio } from '../../lib/sitio';
import { withBase } from '../../lib/withBase';

// Pie propio de la v2: sin filetes ni etiquetas en mayúsculas. El de la home (Footer.astro) es
// compartido y se queda como está.
const anio = new Date().getFullYear();
---

<footer class="bg-carbon px-4 pt-20 pb-10 text-white/85">
  <div class="mx-auto grid max-w-ancho gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="m-0 font-display text-[24px] font-extrabold text-white">{nombreSitio}</p>
      <address class="mt-3 text-[16px] not-italic">
        {titular.nombreLegal}
        <br />
        {titular.domicilio}
      </address>
    </div>

    <nav aria-label="Secciones del pie">
      <ul class="m-0 grid list-none gap-3 p-0 text-[16px]">
        {secciones.map((s) => (
          <li>
            <a
              class="text-inherit no-underline hover:text-teal-light focus-visible:text-teal-light"
              href={withBase(`/#${s.id}`)}
            >
              {s.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="text-[16px]">
      <a
        class="font-bold text-teal-light underline-offset-4 hover:underline focus-visible:underline"
        href={`mailto:${correo}`}
      >
        {correo}
      </a>
      <ul class="m-0 mt-6 grid list-none gap-3 p-0 text-[13px]">
        {legales.map((l) => (
          <li>
            <a
              class="text-inherit underline-offset-4 hover:underline focus-visible:underline"
              href={withBase(l.ruta)}
            >
              {l.texto}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="mx-auto mt-14 mb-0 max-w-ancho text-[13px] text-white/60">
    © {anio} {titular.nombreLegal}. Todos los derechos reservados.
  </p>
</footer>
