---
import { legales } from '../../lib/secciones';
import { correo, mailtoHref, titular } from '../../lib/contacto';
import { withBase } from '../../lib/withBase';

// El pie es la capa más honda: un campo teal entero con el correo como titular. Los créditos de
// las fotografías y los mapas de la página van aquí.
const anio = new Date().getFullYear();
const [usuario, dominio] = correo.split('@');
---

<footer class="v2-marco flex min-h-[90svh] flex-col bg-teal pt-10 pb-8 text-carbon">
  <div class="flex items-start justify-between gap-8 max-[767px]:flex-col max-[767px]:gap-4">
    <div class="v2-pequeno grid gap-1">
      <img
        src={withBase('/img/logo.svg')}
        alt="Magma Consulting"
        width="138"
        height="34"
        class="mb-3 h-7 w-auto brightness-0"
      />
      <p class="m-0">{titular.nombreLegal}</p>
      <p class="m-0">{titular.domicilio}</p>
      <p class="m-0">Consultoría para operadores de telecomunicaciones</p>
    </div>
    <a class="v2-enlace v2-pequeno" href="#inicio">
      Volver arriba
    </a>
  </div>

  <a
    class="mt-auto mb-10 block font-display leading-[0.95] font-extrabold tracking-[-0.03em] text-carbon no-underline hover:text-white focus-visible:text-white"
    style="font-size: clamp(26px, 6.4vw, 96px)"
    href={mailtoHref}
  >
    <span class="block">{usuario}</span>
    <span class="block">@{dominio}</span>
  </a>

  <div class="v2-pequeno grid grid-cols-[1fr_2fr_1fr] gap-6 max-[767px]:grid-cols-1 max-[767px]:gap-3">
    <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0">
      {legales.map((l) => (
        <li>
          <a class="v2-enlace font-normal" href={withBase(l.ruta)}>
            {l.texto}
          </a>
        </li>
      ))}
    </ul>
    <p class="m-0 text-center max-[767px]:text-left">
      Especímenes: Nessa Eull y Mike Davis, CC0. Mapas geológicos de Federico de Botella (1879) y M.
      Faura i Sans (1923), dominio público. Todos en Wikimedia Commons.
    </p>
    <p class="m-0 text-right max-[767px]:text-left">Madrid, {anio}</p>
  </div>
</footer>
