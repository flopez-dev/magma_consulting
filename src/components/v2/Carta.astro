---
import { fases } from '../../lib/servicios';
import { mailtoConsultaHref } from '../../lib/contacto';
import { withBase } from '../../lib/withBase';

// La carta de capas, sobre el Mapa geológico de España de M. Faura i Sans (1923, dominio
// público, Wikimedia Commons). Quien visita marca lo que ya tiene; la carta cuenta lo que falta y
// el botón abre un correo con esa lista. Sin JS: la carta completa y un mailto normal.
//
// Líneas breves propias de la v2 (pendientes de aprobar). «Servicios para empresas» usa la
// primera frase de su texto, que es del cliente y va sin tocar.
const breves: Record<string, string> = {
  'Telefonía móvil': 'Tu propio OMV, de la marca blanca al canal de venta.',
  'Planes de negocio': 'Saber si tu proyecto sale a cuenta antes de invertir.',
  'Servicios de FTTH': 'Fibra mayorista en bitstream, sin desplegar red propia.',
  'Infraestructura de redes': 'Red troncal, tránsito IP, monitorización y respaldo.',
  'Compraventa de redes': 'Te acompañamos al comprar o al vender una red.',
  'Formación en ventas': 'Comerciales, gestores de cuentas y atención al cliente.',
};
const breve = (nombre: string, texto: string) => breves[nombre] ?? texto.split('. ')[0] + '.';

// Borde superior e inferior en zigzag: 40 dientes de 14 px.
const dientes = 40;
const alto = 14;
const arriba = Array.from(
  { length: dientes * 2 + 1 },
  (_, i) => `${(i * 50) / dientes}% ${i % 2 ? 0 : alto}px`,
);
const abajo = Array.from(
  { length: dientes * 2 + 1 },
  (_, i) => `${100 - (i * 50) / dientes}% calc(100% - ${i % 2 ? 0 : alto}px)`,
);
const zigzag = `polygon(${[...arriba, ...abajo].join(', ')})`;
const total = fases.reduce((n, f) => n + f.servicios.length, 0);
---

<section id="carta" class="relative overflow-hidden bg-carbon" aria-labelledby="carta-title">
  <picture class="absolute inset-0">
    <source srcset={withBase('/img/v2/mapa-geologico-faura-1923.webp')} type="image/webp" />
    <img
      class="size-full object-cover"
      src={withBase('/img/v2/mapa-geologico-faura-1923.jpg')}
      alt="Mapa geológico de España de M. Faura i Sans, de 1923"
      width="1920"
      height="1442"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <div class="v2-marco v2-rejilla relative py-[clamp(72px,10vw,160px)] max-[767px]:px-[10px]">
    <div
      class="v2-hoja reveal col-span-6 col-start-7 px-16 py-20 text-center max-[1023px]:col-span-10 max-[1023px]:col-start-2 max-[767px]:col-span-12 max-[767px]:col-start-1 max-[767px]:px-7"
      style={`--zigzag: ${zigzag}`}
      data-carta
    >
      <h2 id="carta-title">Las capas de tu operador</h2>
      <p class="mt-4 mb-0">Marca lo que ya tienes. El resto lo ponemos nosotras.</p>

      {fases.map((fase) => (
        <div class="mt-14">
          <h3 class="font-display font-extrabold">{fase.nombre}</h3>
          <ul class="m-0 mt-5 grid list-none gap-4 p-0 text-left">
            {fase.servicios.map((s) => (
              <li
                class="v2-capa grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4"
                data-capa={s.nombre}
              >
                <div>
                  <p class="m-0 font-display font-bold text-carbon">{s.nombre}</p>
                  <p class="v2-pequeno m-0 text-ink-soft">{breve(s.nombre, s.texto)}</p>
                </div>
                <button type="button" class="v2-capa-boton v2-pequeno" aria-pressed="false" hidden>
                  La tengo
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <p class="v2-frase mt-14 mb-6 text-carbon" data-resumen aria-live="polite">
        Escríbenos y te decimos por dónde empezar.
      </p>
      <a class="v2-boton w-full" href={mailtoConsultaHref} data-pedir data-total={total}>
        Pídenos lo que te falta
      </a>
    </div>
  </div>
</section>

<script>
  import { correo } from '../../lib/contacto';

  const carta = document.querySelector<HTMLElement>('[data-carta]');
  const resumen = carta?.querySelector<HTMLElement>('[data-resumen]');
  const pedir = carta?.querySelector<HTMLAnchorElement>('[data-pedir]');
  const capas = carta ? Array.from(carta.querySelectorAll<HTMLElement>('[data-capa]')) : [];

  const actualizar = () => {
    const tengo = capas.filter((c) => c.querySelector('[aria-pressed="true"]'));
    const faltan = capas.filter((c) => !tengo.includes(c));
    const nombres = (lista: HTMLElement[]) => lista.map((c) => c.dataset.capa).join(', ');

    if (resumen) {
      resumen.textContent = faltan.length
        ? `Te faltan ${faltan.length} de ${capas.length}.`
        : 'Lo tienes todo. Hablemos de crecer.';
    }
    if (pedir) {
      const cuerpo = [
        'Hola,',
        '',
        tengo.length ? `Ya tengo: ${nombres(tengo)}.` : 'Estoy empezando.',
        faltan.length ? `Me falta: ${nombres(faltan)}.` : 'Quiero hacer crecer mi operador.',
        '',
        '¿Hablamos?',
      ].join('\n');
      pedir.href = `mailto:${correo}?subject=${encodeURIComponent('Las capas de mi operador')}&body=${encodeURIComponent(cuerpo)}`;
    }
  };

  if (carta && capas.length) {
    capas.forEach((c) => {
      const boton = c.querySelector<HTMLButtonElement>('button');
      if (!boton) return;
      boton.hidden = false;
      boton.addEventListener('click', () => {
        boton.setAttribute('aria-pressed', String(boton.getAttribute('aria-pressed') !== 'true'));
        actualizar();
      });
    });
    actualizar();
  }
</script>
