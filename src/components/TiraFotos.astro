---
import { withBase } from '../lib/withBase';

// Estrato visual entre #servicios y #credenciales. Las cinco imágenes son las que ya usaba
// la página de servicios de la web anterior (stock genérico a baja resolución): sustituir
// por fotografía propia en cuanto esté disponible. En móvil solo caben las tres primeras.
const fotos = [
  {
    nombre: 'torre-telecomunicaciones',
    alt: 'Torre de telecomunicaciones contra un cielo despejado',
    lado: 500,
  },
  {
    nombre: 'antena-radioenlace',
    alt: 'Antena parabólica de un sistema de radioenlace',
    lado: 500,
  },
  { nombre: 'telefono-movil', alt: 'Persona sujetando un teléfono móvil', lado: 500 },
  {
    nombre: 'firma-contrato',
    alt: 'Firma de un documento con bolígrafo, sobre un plano técnico',
    lado: 500,
  },
  { nombre: 'acuerdo-empresarial', alt: 'Apretón de manos entre dos personas', lado: 500 },
];
const img = (nombre: string, ext: string) => withBase(`/img/servicios/${nombre}.${ext}`);
---

{/* Sin loading="lazy" a propósito: son cinco imágenes pequeñas (25-45 KB) muy cerca del
    principio de la página, y con lazy una captura de página completa las saca en blanco. */}
<div class="grid grid-cols-5 leading-0 max-[640px]:grid-cols-3" role="presentation">
  {fotos.map((f, i) => (
    <picture
      class:list={[
        'tira-foto relative block aspect-square overflow-hidden bg-carbon',
        i >= 3 && 'max-[640px]:hidden',
      ]}
    >
      <source srcset={img(f.nombre, 'webp')} type="image/webp" />
      <img
        class="size-full object-cover"
        src={img(f.nombre, 'jpg')}
        alt={f.alt}
        decoding="async"
        width={f.lado}
        height={f.lado}
      />
    </picture>
  ))}
</div>
