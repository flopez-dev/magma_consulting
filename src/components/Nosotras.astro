---
import { socias } from '../lib/equipo';
import { iconoLinkedin } from '../lib/iconos';
import { nombreSitio } from '../lib/sitio';
import { withBase } from '../lib/withBase';
import Icono from './Icono.astro';

const foto = (nombre: string, ext: string) => withBase(`/img/equipo/${nombre}.${ext}`);
---

<section id="nosotras" class="seccion" aria-labelledby="nosotras-title">
  <div class="seccion-interior">
    <p class="eyebrow">Nosotras</p>
    <h2 id="nosotras-title">Dos socias, una misma trayectoria</h2>
    <p class="seccion-entradilla">
      Te atendemos nosotras mismas, de principio a fin. Quien te asesora conoce el mercado del
      operador local desde dentro.
    </p>

    {/* Sin loading="lazy" en los retratos, por el mismo motivo que la tira de fotografía. */}
    <div class="mt-12 grid grid-cols-2 gap-12 max-[720px]:grid-cols-1 max-[720px]:gap-10">
      {socias.map((s) => (
        <article class="miembro reveal">
          <picture class="retrato block aspect-square overflow-hidden rounded-lg bg-mist">
            <source srcset={foto(s.foto.nombre, 'webp')} type="image/webp" />
            <img
              class="size-full object-cover"
              src={foto(s.foto.nombre, 'jpg')}
              alt={`${s.nombre}, socia de ${nombreSitio}`}
              decoding="async"
              width={s.foto.ancho}
              height={s.foto.alto}
            />
          </picture>
          <div class="mt-5">
            <h3>{s.nombre}</h3>
            <p>{s.bio}</p>
            {/* La bio corta siempre visible; el resto de la trayectoria se despliega a
                  demanda en vez de alargar cada tarjeta por defecto. */}
            <details class="ver-mas -mt-1 mb-3">
              <summary class="inline-block cursor-pointer font-display text-[0.85rem] font-bold text-teal-deep transition-colors duration-200 ease-suave hover:text-carbon focus-visible:text-carbon">
                Ver más
              </summary>
              <p class="mt-[0.6rem] mb-0 text-[0.95rem] text-ink-soft">{s.masBio}</p>
            </details>
            <p class="text-[0.9rem] text-ink-soft">{s.trayectoria}</p>
            <a
              class="mt-2 inline-flex items-center gap-2 font-display text-[0.9rem] font-bold text-teal-deep no-underline transition-colors duration-200 ease-suave hover:text-carbon focus-visible:text-carbon"
              href={s.linkedin}
              target="_blank"
              rel="noopener"
            >
              <Icono d={iconoLinkedin} />
              LinkedIn de {s.nombre}
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
