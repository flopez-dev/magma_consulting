---
const cifras = [
  { valor: '20+', texto: 'años trabajando juntas en el sector' },
  { valor: '800+', texto: 'operadores locales, a nivel nacional' },
  { valor: '50+', texto: 'empresas consolidadas' },
];
---

<section id="credenciales" class="seccion seccion-oscura" aria-labelledby="credenciales-title">
  <div class="seccion-interior">
    <p class="eyebrow eyebrow-oscuro">Trayectoria</p>
    <h2 id="credenciales-title">
      Más de 20 años construyendo el mercado local de telecomunicaciones
    </h2>

    <ul class="mt-10 mb-0 flex list-none flex-wrap gap-x-14 gap-y-10 p-0">
      {cifras.map((c) => (
        <li class="reveal">
          <span class="block font-display text-[clamp(2.5rem,2rem+2vw,3.75rem)] leading-none font-extrabold text-teal">
            {c.valor}
          </span>
          <span class="mt-2 block max-w-[20ch] text-[0.95rem] text-white/75">{c.texto}</span>
        </li>
      ))}
    </ul>

    <p class="reveal mt-10 max-w-[62ch] border-t border-white/15 pt-8 text-[1.05rem]">
      Han sido parte de hitos como el primer Operador Móvil Virtual completo de España (Cablemóvil),
      Ion Mobile y Avatel Móvil.
    </p>
  </div>
</section>
