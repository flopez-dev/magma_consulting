---
import { secciones, contacto } from '../lib/secciones';
import { nombreSitio } from '../lib/sitio';
import { withBase } from '../lib/withBase';

// En la home los enlaces son anclas (#servicios) y hacen scroll; desde las demás páginas
// llevan a la home con el ancla.
const enHome = Astro.url.pathname === withBase('/');
const ancla = (id: string) => (enHome ? `#${id}` : withBase(`/#${id}`));

const enlace =
  'border-b-2 border-transparent py-1 font-display text-[0.9rem] font-bold tracking-[0.02em] text-white no-underline transition-colors duration-200 ease-suave hover:border-teal-light focus-visible:border-teal-light max-[780px]:border-b max-[780px]:border-white/10 max-[780px]:px-4 max-[780px]:py-[0.9rem]';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-100 flex h-cabecera items-center bg-transparent transition-[background-color,box-shadow] duration-300 ease-suave data-scrolled:bg-carbon data-scrolled:shadow-dark"
>
  <div class="mx-auto flex w-full max-w-ancho items-center gap-6 px-4">
    <a
      class="mr-auto flex items-center"
      href={enHome ? '#hero' : withBase('/')}
      aria-label={`${nombreSitio}, inicio`}
    >
      {/* El SVG es teal sobre transparente: se lee igual sobre el hero que sobre la cabecera
          ya rellena de carbón, así que no hace falta invertirlo a blanco. */}
      <img
        class="h-[28px] w-[140px]"
        src={withBase('/img/logo.svg')}
        alt={nombreSitio}
        width="140"
        height="28"
      />
    </a>

    <button
      class="hidden size-11 cursor-pointer items-center justify-center rounded-sm border border-white/40 bg-transparent p-0 max-[780px]:flex"
      type="button"
      aria-expanded="false"
      aria-controls="nav"
      data-nav-toggle
    >
      <span class="sr-only" data-nav-label>
        Abrir menú
      </span>
      <span class="nav-toggle-barras" aria-hidden="true"></span>
    </button>

    {/* Solo cuatro enlaces: el menú aguanta en línea hasta 780 px, por debajo del 900 px
        habitual en otras landings. El breakpoint coincide con el matchMedia del script. */}
    <nav
      id="nav"
      aria-label="Navegación principal"
      class="flex items-center gap-[1.8rem] max-[780px]:fixed max-[780px]:inset-x-0 max-[780px]:top-cabecera max-[780px]:max-h-[calc(100vh-var(--spacing-cabecera))] max-[780px]:flex-col max-[780px]:items-stretch max-[780px]:gap-0 max-[780px]:overflow-y-auto max-[780px]:bg-carbon max-[780px]:py-2 max-[780px]:shadow-dark"
    >
      {secciones.map((s) => (
        <a href={ancla(s.id)} class={enlace}>
          {s.texto}
        </a>
      ))}
      <a
        href={ancla(contacto.id)}
        class="rounded-sm bg-teal px-[1.2rem] py-1 font-display text-[0.9rem] font-bold tracking-[0.02em] text-carbon no-underline transition-colors duration-200 ease-suave hover:bg-teal-light focus-visible:bg-teal-light max-[780px]:mx-4 max-[780px]:mt-3 max-[780px]:mb-1 max-[780px]:px-4 max-[780px]:py-[0.9rem] max-[780px]:text-center"
      >
        {contacto.texto}
      </a>
    </nav>
  </div>
</header>

<script>
  const cabecera = document.getElementById('site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('nav');
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---- Menú móvil ----------------------------------------------------------------
  if (toggle && nav) {
    const movil = window.matchMedia('(max-width: 780px)');
    const etiqueta = toggle.querySelector('[data-nav-label]');

    const fijar = (abierto: boolean) => {
      toggle.setAttribute('aria-expanded', String(abierto));
      if (etiqueta) etiqueta.textContent = abierto ? 'Cerrar menú' : 'Abrir menú';
    };
    const cerrar = () => {
      nav.hidden = true;
      fijar(false);
    };
    const abrir = () => {
      nav.hidden = false;
      fijar(true);
    };
    // En escritorio el menú está siempre a la vista; en móvil arranca cerrado.
    const sincronizar = () => {
      if (movil.matches) {
        cerrar();
      } else {
        nav.hidden = false;
        fijar(false);
      }
    };

    toggle.addEventListener('click', () => (nav.hidden ? abrir() : cerrar()));

    nav.addEventListener('click', (e) => {
      if (movil.matches && (e.target as Element).closest('a')) cerrar();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && movil.matches && !nav.hidden) {
        cerrar();
        toggle.focus();
      }
    });

    // El foco da la vuelta dentro del menú abierto.
    nav.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || nav.hidden) return;
      const enlaces = nav.querySelectorAll<HTMLAnchorElement>('a');
      if (!enlaces.length) return;
      const primero = enlaces[0];
      const ultimo = enlaces[enlaces.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    });

    movil.addEventListener('change', sincronizar);
    sincronizar();
  }

  // ---- Fondo de la cabecera al hacer scroll -------------------------------------
  if (cabecera) {
    let pendiente = false;
    const aplicar = () => {
      pendiente = false;
      cabecera.toggleAttribute('data-scrolled', window.scrollY > 40);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!pendiente) {
          window.requestAnimationFrame(aplicar);
          pendiente = true;
        }
      },
      { passive: true },
    );
    aplicar();
  }

  // ---- Scroll suave a las anclas, descontando la cabecera fija ----------------------
  document.addEventListener('click', (e) => {
    const enlace = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!enlace) return;
    const id = enlace.getAttribute('href');
    if (!id || id === '#') return;
    const destino = document.querySelector<HTMLElement>(id);
    if (!destino) return;

    e.preventDefault();
    const alto = cabecera ? cabecera.getBoundingClientRect().height : 0;
    window.scrollTo({
      top: destino.getBoundingClientRect().top + window.scrollY - alto - 12,
      behavior: movimientoReducido.matches ? 'auto' : 'smooth',
    });
    history.pushState(null, '', id);
    destino.setAttribute('tabindex', '-1');
    destino.focus({ preventScroll: true });
  });
</script>
